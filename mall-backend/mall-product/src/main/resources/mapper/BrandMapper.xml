<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyh.mallproduct.mapper.BrandMapper">

    <resultMap id="BaseResultMap" type="com.cyh.mallproduct.entity.Brand">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="logo" property="logo" />
        <result column="description" property="description" />
        <result column="website" property="website" />
        <result column="sort" property="sort" />
        <result column="status" property="status" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <sql id="Base_Column_List">
        id, name, logo, description, website, sort, status, created_at, updated_at
    </sql>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM brands
        WHERE status = #{status}
          AND is_deleted = 0
        ORDER BY sort ASC, created_at DESC
    </select>

    <select id="selectByNameLike" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM brands
        WHERE name LIKE CONCAT('%', #{name}, '%')
          AND status = 1
          AND is_deleted = 0
        ORDER BY sort ASC, created_at DESC
    </select>

    <select id="selectBySort" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM brands
        WHERE status = 1
          AND is_deleted = 0
        ORDER BY sort ASC
    </select>

</mapper>