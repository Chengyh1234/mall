<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cyh.mallproduct.mapper.SkuSaleAttrValueMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.cyh.mallproduct.entity.SkuSaleAttrValue">
        <id column="id" property="id"/>
        <result column="sku_id" property="skuId"/>
        <result column="attr_value_id" property="attrValueId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 根据SKU ID获取关联的销售属性值列表 -->
    <select id="getBySkuId" resultMap="BaseResultMap">
        SELECT * FROM sku_sale_attr_values 
        WHERE sku_id = #{skuId}
        ORDER BY id ASC
    </select>

    <!-- 根据SKU ID列表批量获取关联的销售属性值 -->
    <select id="getBySkuIds" resultMap="BaseResultMap">
        SELECT * FROM sku_sale_attr_values 
        WHERE sku_id IN 
        <foreach collection="skuIds" item="skuId" open="(" separator="," close=")">
            #{skuId}
        </foreach>
        ORDER BY sku_id ASC, id ASC
    </select>

    <!-- 根据SKU ID删除关联的销售属性值 -->
    <!--<delete id="deleteBySkuId">-->
    <!--    DELETE FROM sku_sale_attr_values -->
    <!--    WHERE sku_id = #{skuId}-->
    <!--</delete>-->

    <!-- 根据属性值ID获取关联的SKU列表 -->
    <select id="getByAttrValueId" resultMap="BaseResultMap">
        SELECT * FROM sku_sale_attr_values 
        WHERE attr_value_id = #{attrValueId}
        ORDER BY id ASC
    </select>

</mapper>