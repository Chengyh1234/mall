<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyh.mallorder.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.cyh.mallorder.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="sku_id" property="skuId"/>
        <result column="spu_id" property="spuId"/>
        <result column="product_name" property="productName"/>
        <result column="product_image" property="productImage"/>
        <result column="sku_specs" property="skuSpecs"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="created_at" property="createdAt"/>
        <result column="gift_flag" property="giftFlag"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM order_items WHERE order_id = #{orderId}
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM order_items WHERE order_no = #{orderNo}
    </select>

    <select id="selectByOrderIds" resultMap="BaseResultMap">
        SELECT * FROM order_items WHERE order_id IN
        <foreach collection="list" item="orderId" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </select>

    <select id="selectBySkuId" resultMap="BaseResultMap">
        SELECT * FROM order_items WHERE sku_id = #{skuId}
    </select>
</mapper>