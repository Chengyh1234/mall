<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyh.mallorder.mapper.OrderDeliveryMapper">

    <resultMap id="BaseResultMap" type="com.cyh.mallorder.entity.OrderDelivery">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="delivery_company" property="deliveryCompany"/>
        <result column="delivery_no" property="deliveryNo"/>
        <result column="delivery_status" property="deliveryStatus"/>
        <result column="sender" property="sender"/>
        <result column="sender_id" property="senderId"/>
        <result column="delivery_time" property="deliveryTime"/>
        <result column="package_count" property="packageCount"/>
        <result column="weight" property="weight"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="receiver_phone" property="receiverPhone"/>
        <result column="sign_time" property="signTime"/>
        <result column="signer" property="signer"/>
        <result column="exception_reason" property="exceptionReason"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM order_delivery WHERE order_id = #{orderId} ORDER BY created_at DESC
    </select>

    <select id="selectByDeliveryNo" resultMap="BaseResultMap">
        SELECT * FROM order_delivery WHERE delivery_no = #{deliveryNo}
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT * FROM order_delivery WHERE delivery_status = #{deliveryStatus} ORDER BY created_at DESC
    </select>

    <select id="countByOrderId" resultType="int">
        SELECT COUNT(*) FROM order_delivery WHERE order_id = #{orderId}
    </select>
</mapper>