<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyh.mallstore.mapper.StoreMapper">

    <resultMap id="BaseResultMap" type="com.cyh.mallstore.entity.Store">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="seller_id" property="sellerId" />
        <result column="logo" property="logo" />
        <result column="banner" property="banner" />
        <result column="description" property="description" />
        <result column="phone" property="phone" />
        <result column="address" property="address" />
        <result column="business_license" property="businessLicense" />
        <result column="status" property="status" />
        <result column="reject_reason" property="rejectReason" />
        <result column="sort" property="sort" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <resultMap id="StoreVOResultMap" type="com.cyh.mallstore.vo.StoreVo">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="logo" property="logo" />
        <result column="description" property="description" />
    </resultMap>

    <sql id="Base_Column_List">
        id, name, seller_id, logo, banner, description, phone, address, business_license, status, reject_reason, sort, created_at, updated_at
    </sql>

    <sql id="StoreVO_Column_List">
        id, name, logo, description
    </sql>

    <select id="selectBySellerId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM stores WHERE seller_id = #{sellerId}
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM stores WHERE status = #{status}
        ORDER BY sort ASC, created_at DESC
    </select>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM stores WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY sort ASC, created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countPage" resultType="int">
        SELECT COUNT(*) FROM stores WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
    </select>

    <select id="selectPageVO" resultMap="StoreVOResultMap">
        SELECT <include refid="StoreVO_Column_List" />
        FROM stores WHERE status = 1
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY sort ASC, created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countPageVO" resultType="int">
        SELECT COUNT(*) FROM stores WHERE status = 1
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
    </select>

    <select id="selectAdminPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM stores WHERE 1=1
        <if test="id != null">
            AND id = #{id}
        </if>
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="status == null">
            AND status IN (0, 1, 3)
        </if>
        <if test="sellerId != null">
            AND seller_id = #{sellerId}
        </if>
        <if test="phone != null and phone != ''">
            AND phone LIKE CONCAT('%', #{phone}, '%')
        </if>
        ORDER BY sort ASC, created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countAdminPage" resultType="int">
        SELECT COUNT(*) FROM stores WHERE 1=1
        <if test="id != null">
            AND id = #{id}
        </if>
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="status == null">
            AND status IN (0, 1)
        </if>
        <if test="sellerId != null">
            AND seller_id = #{sellerId}
        </if>
        <if test="phone != null and phone != ''">
            AND phone LIKE CONCAT('%', #{phone}, '%')
        </if>
    </select>

</mapper>