<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cyh.mallportal.mapper.SpuSaleAttrChoiceMapper">

    <!-- 根据SPU ID获取销售属性选择列表 -->
    <select id="getBySpuId" resultType="com.cyh.mallportal.entity.SpuSaleAttrChoice">
        SELECT * FROM spu_sale_attr_choice WHERE spu_id = #{spuId} ORDER BY attr_id ASC
    </select>

</mapper>
